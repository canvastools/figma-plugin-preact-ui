{
  "name": "figma-plugin-preact-ui",
  "version": "1.0.0",
  "description": "Preact UI library inspired by Figma's UI3, designed for plugin development.",
  "keywords": [
    "figma",
    "plugin",
    "ui",
    "preact"
  ],
  "author": "Canvas Tools",
  "license": "MIT",
  "homepage": "https://canvastools.github.io/figma-plugin-preact-ui/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/canvastools/figma-plugin-preact-ui.git"
  },
  "bugs": {
    "url": "https://github.com/canvastools/figma-plugin-preact-ui/issues"
  },
  "main": "./dist/index.es.js",
  "module": "./dist/index.es.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "peerDependencies": {
    "@preact/compat": "^17.1.2",
    "preact": "^10.26.5"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "devDependencies": {
    "sass": "^1.83.0",
    "@chromatic-com/storybook": "^1.5.0",
    "@preact/compat": "^17.1.2",
    "@preact/preset-vite": "^2.10.1",
    "@storybook/addon-essentials": "^8.1.6",
    "@storybook/addon-interactions": "^8.1.6",
    "@storybook/addon-links": "^8.1.6",
    "@storybook/blocks": "^8.1.6",
    "@storybook/preact": "^8.1.6",
    "@storybook/preact-vite": "^8.1.6",
    "@storybook/test": "^8.1.6",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.54.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "eslint-plugin-storybook": "^0.8.0",
    "gh-pages": "^6.1.1",
    "glob": "^11.0.1",
    "preact": "^10.26.5",
    "rollup-plugin-dts": "^6.2.1",
    "storybook": "^8.1.6",
    "storybook-addon-sass-postcss": "^0.2.0",
    "typescript": "^5.4.0",
    "vite": "^5.4.17",
    "vite-plugin-dts": "^4.5.3"
  },
  "scripts": {
    "build": "vite build",
    "watch": "vite build --watch",
    "prod": "vite build && tsc -p tsconfig.types.json && node ./scripts/clean-scss-imports.js && rollup -c rollup.config.dts.js && rm -rf dist/tmp-types && tsc && eslint . || true",
    "lint": "tsc && eslint . || true",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "STORYBOOK_BASE_PATH=/figma-plugin-preact-ui/ storybook build",
    "deploy-storybook": "touch storybook-static/.nojekyll && gh-pages -d storybook-static --dotfiles"
  },
  "dependencies": {
    "react-calendar": "^6.0.0",
    "react-colorful": "^5.6.1",
    "react-time-picker": "^8.0.2"
  }
}

{
  "name": "figma-plugin-preact-ui",
  "version": "1.3.2",
  "description": "Preact UI library inspired by Figma's UI3, designed for plugin development.",
  "keywords": [
    "figma",
    "plugin",
    "ui",
    "preact"
  ],
  "author": "Canvas Tools",
  "license": "MIT",
  "homepage": "https://canvastools.github.io/figma-plugin-preact-ui/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/canvastools/figma-plugin-preact-ui.git"
  },
  "bugs": {
    "url": "https://github.com/canvastools/figma-plugin-preact-ui/issues"
  },
  "main": "./dist/index.es.js",
  "module": "./dist/index.es.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "browserslist": [
    "chrome >= 110",
    "edge >= 110",
    "firefox >= 115",
    "safari >= 16.4"
  ],
  "peerDependencies": {
    "@preact/compat": "^17.1.2 || ^18.0.0",
    "preact": "^10.26.5"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@eslint/js": "^10.0.1",
    "@preact/compat": "^18.3.2",
    "@preact/preset-vite": "^2.10.5",
    "@storybook/addon-docs": "^10.5.0",
    "@storybook/addon-links": "^10.5.0",
    "@storybook/preact": "^10.5.0",
    "@storybook/preact-vite": "^10.5.0",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.5.0",
    "gh-pages": "^6.3.0",
    "glob": "^13.0.6",
    "preact": "^10.29.7",
    "rollup-plugin-dts": "^6.4.1",
    "sass": "^1.101.0",
    "storybook": "^10.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.4",
    "vite-plugin-dts": "^5.0.3"
  },
  "scripts": {
    "build": "vite build",
    "watch": "vite build --watch",
    "prod": "vite build && tsc -p tsconfig.types.json && node ./scripts/clean-scss-imports.js && rollup -c rollup.config.dts.js && rm -rf dist/tmp-types && tsc && eslint . || true",
    "lint": "tsc && eslint . || true",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "STORYBOOK_BASE_PATH=/figma-plugin-preact-ui/ storybook build",
    "deploy-storybook": "npm run build-storybook && touch storybook-static/.nojekyll && gh-pages -d storybook-static --dotfiles"
  },
  "dependencies": {
    "react-calendar": "^6.0.1",
    "react-colorful": "^5.7.0",
    "react-time-picker": "^8.0.3"
  }
}
